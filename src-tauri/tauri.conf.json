{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost"
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "decorations": false,
        "height": 300,
        "label": "companion",
        "resizable": false,
        "skipTaskbar": true,
        "title": "Nila",
        "transparent": true,
        "visible": false,
        "width": 220
      }
    ]
  },
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "../character/states/idle.png"
    ],
    "shortDescription": "A gentle Malayalam desktop reminder companion",
    "targets": [
      "deb",
      "appimage"
    ]
  },
  "identifier": "app.nila.companion",
  "plugins": {
    "sql": {}
  },
  "productName": "നില",
  "version": "0.1.0"
}